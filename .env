# The PMS backend. No trailing slash.
VITE_DIVIC_API_URL=https://divic-backend.onrender.com

# Where staff sign in to the hotel software. Renders a quiet footer link.
# Leave blank to hide the link entirely.
#VITE_PMS_URL=https://divic-pms.onrender.com

VITE_PMS_URL=https://jerome-2003.github.io/divic-frontend/

# ONLY the public key may ever appear here. Anything prefixed VITE_ is compiled
# into the JavaScript bundle and readable by anyone who opens dev tools. The
# Paystack SECRET key belongs in the backend environment and nowhere else.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

